    {
      "id": "M1",
      "t": 2,
      "dur": 2,
      "room": "room207",
      "chars": [
        "mina"
      ],
      "title": "真鍮の鍵",
      "lines": [
        {
          "text": "真鍮の鍵のタグは「207」。ミナが扉を開ける。"
        },
        {
          "text": "窓を押し上げる。正面に、時計塔の窓。"
        },
        {
          "who": "mina",
          "text": "ここか"
        }
