{
  "name": "営業部",
  "mission": "商談の事前準備と提案書の下書きを作り、営業担当が顧客と向き合う時間を増やす",
  "human_approval": [
    "価格・値引き・納期の約束",
    "提案書・メールの送付",
    "顧客情報の社外共有"
  ],
  "banned": [
    "必ず(効果|成果)が出",
    "業界No\\.?1",
    "最安"
  ],
  "max_revisions": 2,
  "stages": [
    {
      "key": "research",
      "label": "01 顧客リサーチ担当",
      "skill": "org-sales-research",
      "output": "01-account.md",
      "sections": [
        "顧客概要",
        "課題の仮説",
        "商談で確認する質問",
        "出典"
      ],
      "chars": [
        400,
        6000
      ],
      "review_points": [
        "顧客の公開情報と依頼資料に基づいているか（推測は推測と書いてあるか）",
        "課題の仮説が自社の提供価値とつながっているか",
        "質問が仮説を確かめる内容になっているか",
        "個人の私生活などの不要な情報を集めていないか"
      ]
    },
    {
      "key": "proposal",
      "label": "02 提案書担当",
      "skill": "org-sales-proposal",
      "output": "02-proposal.md",
      "sections": [
        "提案の要旨",
        "課題と解決策",
        "導入ステップ",
        "費用の考え方",
        "次回アクション"
      ],
      "chars": [
        600,
        7000
      ],
      "patterns": [
        "要承認"
      ],
      "review_points": [
        "顧客の課題の仮説に答えているか",
        "自社の提供内容（依頼資料）を超える約束をしていないか",
        "価格・値引き・納期を確定していないか（「要承認」と書いてあるか）",
        "顧客目線の言葉で書かれているか"
      ]
    }
  ]
}
