{
  "name": "経営企画部",
  "mission": "市場・競合を調べ、経営判断の材料になるレポートを作る",
  "human_approval": [
    "投資・事業・価格などの意思決定",
    "数字を社外向け資料に使う前の原典確認"
  ],
  "banned": [
    "必ず成功",
    "間違いなく"
  ],
  "max_revisions": 2,
  "stages": [
    {
      "key": "research",
      "label": "01 市場調査担当",
      "skill": "org-planning-research",
      "output": "01-research.md",
      "sections": [
        "調査の問い",
        "市場",
        "競合",
        "数字の一覧",
        "出典"
      ],
      "min_urls": 3,
      "chars": [
        600,
        8000
      ],
      "review_points": [
        "問いに答えるのに必要な情報が揃っているか",
        "数字ごとに出典があり、実績・試算・目標を区別しているか",
        "出典が一次情報か、新しいか"
      ]
    },
    {
      "key": "report",
      "label": "02 レポート担当",
      "skill": "org-planning-report",
      "output": "02-report.md",
      "sections": [
        "エグゼクティブサマリー",
        "示唆",
        "リスクと不確実性",
        "推奨アクション"
      ],
      "chars": [
        500,
        6000
      ],
      "patterns": [
        "^##\\s*推奨アクション"
      ],
      "review_points": [
        "サマリーだけ読んで結論が分かるか",
        "示唆が調査メモの事実から導かれているか",
        "推奨アクションに担当・期限・判断が必要な人が書かれているか",
        "不確実な点を隠していないか"
      ]
    }
  ]
}
